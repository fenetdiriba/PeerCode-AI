# ---- Frontend (Vite). These are baked in at build time: redeploy after changing them. ----

# The PeerCode server (signaling + matchmaking). http(s):// is converted to ws(s):// for you.
# Local: run `npm run server`. Production: your Railway/Render URL.
VITE_SERVER_URL="http://localhost:4444"

# Optional: STUN/TURN servers as JSON, for peers on strict networks that can't connect directly.
# VITE_ICE_SERVERS='[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]'

# Optional overrides if signaling and matchmaking ever live on different hosts.
# VITE_SIGNALING_URLS="wss://signal-1.example.com,wss://signal-2.example.com"
# VITE_MATCHMAKING_URL="wss://match.example.com/match"

# ---- Server (set these on Railway/Render, not in the frontend). ----
# ALLOWED_ORIGINS="https://peercode.vercel.app,https://peercode-*.vercel.app"
# MAX_CONNECTIONS_PER_IP="20"

# AI code hints (server only; never put this in a VITE_ variable). Get one at aistudio.google.com/apikey
# GEMINI_API_KEY="your-key"
# GEMINI_MODEL="gemini-flash-latest,gemini-2.5-flash"   (optional; tried in order)
# AI_REQUESTS_PER_10_MIN="20"

# Time-travel debugger (server only).
# Meta Model API key for Muse Spark analysis. Never put it in a VITE_ variable.
# MODEL_API_KEY="your-meta-key"
# META_BASE_URL="https://api.meta.ai/v1"
# META_MODEL="muse-spark-1.3"
# META_JSON_MODE="off"          (only if the API rejects response_format)
# REVISIONS_DIR="data/revisions" (use a persistent volume in production)
# TEST_TIMEOUT_MS="8000"
