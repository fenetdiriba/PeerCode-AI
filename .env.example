# Comma-separated y-webrtc signaling server URLs.
# Run `npm run signal` locally, or point this at your deployed signaling server (e.g. wss://your-app.up.railway.app).
# Tabs in the same browser sync over BroadcastChannel even without a signaling server.
VITE_SIGNALING_URLS="ws://localhost:4444"

# Matchmaking queue, served by the same server (`npm run server`) on the /match path.
VITE_MATCHMAKING_URL="ws://localhost:4444/match"

# GEMINI_API_KEY: for the upcoming AI code hints feature (Phase 4). Not used yet.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
